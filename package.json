{
  "name": "dynamic-assist",
  "private": true,
  "version": "2026.9.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build.mjs",
    "postbuild": "pwsh -NoProfile -File ../extension-publisher/New-ExtensionPackage.ps1 -ProjectPath . -Name dynamics-assist-beta",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "store": "pwsh -NoProfile -File ../extension-publisher/Publish-Extension.ps1 -ProjectPath .",
    "store:publish": "pwsh -NoProfile -File ../extension-publisher/Publish-Extension.ps1 -ProjectPath . -Mode Publish",
    "store:status": "pwsh -NoProfile -File ../extension-publisher/Publish-Extension.ps1 -ProjectPath . -Mode Status",
    "icons": "node scripts/make-icons.mjs",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "test:report": "node scripts/vitest.mjs run --reporter=default --reporter=json --outputFile.json=tests/results/unit-latest.json && node tests/unit-report.mjs",
    "test:live": "node tests/live/run.mjs",
    "marketing": "npm run build && node marketing/build.mjs",
    "marketing:shots": "node marketing/capture.mjs",
    "marketing:brochure": "node marketing/brochure.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rolldown": "^1.2.10",
    "tailwindcss": "^4",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.1"
  }
}
