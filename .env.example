# Copy to .env (git-ignored) and fill it in. The repositories are public, so your
# real tenant, environment, company and org go only in .env. `pnpm test` fails if
# one of them turns up in a file git would commit.
#
# Use a sandbox and a dev org: see tests/README.md.

# Business Central
DA_E2E_BC_TENANT=00000000-0000-0000-0000-000000000000
DA_E2E_BC_ENVIRONMENT=SANDBOX
DA_E2E_BC_COMPANY=CRONUS
DA_E2E_BC_OTHER_COMPANY=My Company

# Dynamics 365
DA_E2E_CE_ORG=https://yourdevorg.crm.dynamics.com

# Optional. A user to impersonate, by name or email. Left empty, the tests pick an
# enabled user without System Administrator.
DA_E2E_IMPERSONATE_USER=

# Optional. Anything else that must stay out of the repositories, separated by commas.
DA_PRIVATE_VALUES=
